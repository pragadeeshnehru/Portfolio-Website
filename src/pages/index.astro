---
import '../styles/global.css';
import react from '../icons/react.svg?raw';
import nextdotjs from '../icons/nextdotjs.svg?raw';
import tailwindcss from '../icons/tailwindcss.svg?raw';
import threedotjs from '../icons/threedotjs.svg?raw';
import nodedotjs from '../icons/nodedotjs.svg?raw';
import gnubash from '../icons/gnubash.svg?raw';
import python from '../icons/python.svg?raw';
