4" r="1.8" fill="var(--bone)" opacity=".45"/><circle cx="112.5" cy="170.9" r="1.8" fill="var(--bone)" opacity=".45"/><circle cx="87.5" cy="170.9" r="1.8" fill="var(--bone)" opacity=".45"/><circle cx="64.0" cy="162.4" r="1.8" fill="var(--bone)" opacity=".45"/><circle cx="44.8" cy="146.3" r="1.8" fill="var(--bone)" opacity=".45"/><circle cx="32.3" cy="124.6" r="1.8" fill="var(--bone)" opacity=".45"/><circle cx="28.0" cy="100.0" r="1.8" fill="var(--bone)" opacity=".45"/><circle cx="32.3" cy="75.4" r="1.8" fill="var(--bone)" opacity=".45"/><circle cx="44.8" cy="53.7" r="1.8" fill="var(--bone)" opacity=".45"/><circle cx="64.0" cy="37.6" r="1.8" fill="var(--bone)" opacity=".45"/><circle cx="87.5" cy="29.1" r="1.8" fill="var(--bone)" opacity=".45"/><circle cx="112.5" cy="29.1" r="1.8" fill="var(--bone)" opacity=".45"/><circle cx="136.0" cy="37.6" r="1.8" fill="var(--bone)" opacity=".45"/><circle cx="155.2" cy="53.7" r="1.8" fill="var(--bone)" opacity=".45"/><circle cx="167.7" cy="75.4" r="1.8" fill="var(--bone)" opacity=".45"/></g><g class="sh sh6"><circle class="pe" cx="184.0" cy="100.0" r="3" fill="var(--gold)"/><circle cx="142.0" cy="172.7" r="1.8" fill="var(--bone)" opacity=".45"/><circle cx="58.0" cy="172.7" r="1.8" fill="var(--bone)" opacity=".45"/><circle cx="16.0" cy="100.0" r="1.8" fill="var(--bone)" opacity=".45"/><circle cx="58.0" cy="27.3" r="1.8" fill="var(--bone)" opacity=".45"/><circle cx="142.0" cy="27.3" r="1.8" fill="var(--bone)" opacity=".45"/></g>';

const personas = [
    { img: '/img/dev.webp', alt: 'Pragadeesh, developer', title: 'Software Developer and Curious Learner',
      text: 'With a love for reading and writing, I explore topics ranging from philosophy to fiction. I enjoy expanding my technical skills by learning about machine learning to create meaningful and practical solutions.' },
    { img: '/img/writer.webp', alt: 'Writing desk', title: 'Creative Technologist and Writer',
      text: 'I strive to blend creativity with logic in my work. Writing fiction and philosophy inspires me to build thoughtful solutions, whether through code or learning new technologies like machine learning.' },
    { img: '/img/artist.webp', alt: 'Artwork in progress', title: 'Developer, Artist, and Lifelong Learner',
      text: 'Curious by nature, I explore diverse interests, from philosophy and fiction writing to learning a bit of machine learning. My goal is to continuously improve my skills and create meaningful, user-friendly solutions.' },
    { img: '/img/designer.webp', alt: 'Design work', title: 'Writer and Tech Enthusiast',
      text: 'I am a developer with a passion for combining creativity and technology. Whether it is writing fiction, exploring philosophy, or learning about machine learning, I strive to bring thoughtful solutions to every project I work on.' },
];

const panels = [
    { src: '/art/guts.webp', title: 'Guts', quote: "I'd rather fight for my life than live it." },
    { src: '/art/hiphop.webp', title: 'Hip Hop', quote: 'If I told you a flower bloomed in a dark room would you trust it?' },
    { src: '/art/skull-knight.webp', title: 'Skull Knight', quote: 'Struggle, endure, contend.' },
    { src: '/art/butterfly-girl.webp', title: 'Butterfly Girl', quote: 'Perfectly imperfect!' },
    { src: '/art/guts-griffith.webp', title: 'Guts & Griffith', quote: 'The greatest nemesis.' },
    { src: '/art/itadori.webp', title: 'Itadori Yuji', quote: 'Hesitation is defeat.' },
    { src: '/art/elden-lord.webp', title: 'Elden Lord', quote: 'Love over Power.' },
    { src: '/art/gal-gadot.webp', title: 'Gal Gadot', quote: 'Timeless elegance.' },
    { src: '/art/jack-sparrow.webp', title: 'Jack Sparrow', quote: "Where's the rum gone?" },
    { src: '/art/walter-white.webp', title: 'Walter White', quote: 'Say my name.' },
    { src: '/art/paul-atriedes.webp', title: 'Paul Atreides', quote: 'The eye of the Messiah.' },
    { src: '/art/doom.webp', title: 'Doom', quote: 'The only thing they fear is you.' },
    { src: '/art/assassin-ezio.webp', title: 'Assassin Ezio', quote: 'The world will not suffer if it ends too soon.' },
    { src: '/art/thomas-shelby.webp', title: 'Thomas Shelby', quote: "Oh and there's a woman!" },
    { src: '/art/sekiro.webp', title: 'Sekiro', quote: 'Hesitation is defeat.' },
    { src: '/art/berserker.webp', title: 'Berserker Armour', quote: 'A beast of darkness.' },
    { src: '/art/breakingbad.webp', title: 'Breaking Bad', quote: 'Live free or die.' },
];

const tech = [
    { group: 'My Expertise', items: [
        { svg: react, name: 'ReactJS' }, { svg: nextdotjs, name: 'NextJS' }, { svg: tailwindcss, name: 'Tailwind' },
        { svg: threedotjs, name: 'Three.js' }, { svg: nodedotjs, name: 'Node.js' } ] },
    { group: 'Languages', items: [
        { svg: gnubash, name: 'Shell' }, { svg: python, name: 'Python' }, { svg: cplusplus, name: 'C++' },
        { svg: csharp, name: 'C#' }, { svg: openjdk, name: 'Java' }, { svg: javascript, name: 'JavaScript' } ] },
    { group: 'Databases', items: [
        { svg: mysql, name: 'MySQL' }, { svg: mongodb, name: 'MongoDB' } ] },
];

const techColors = {'ReactJS': '#61dafb', 'NextJS': '#b8b8c8', 'Tailwind': '#38bdf8', 'Three.js': '#bcbcbc', 'Node.js': '#68bf64', 'Shell': '#77e09e', 'Python': '#ffd343', 'C++': '#6295cb', 'C#': '#b37bd6', 'Java': '#f89820', 'JavaScript': '#f7df1e', 'MySQL': '#2d9ac7', 'MongoDB': '#47c46b'};

const socials = [
    { svg: youtube, name: 'YouTube', href: 'https://www.youtube.com/@Excelsior004' },
    { svg: linkedin, name: 'LinkedIn', href: 'https://www.linkedin.com/in/pragadeesh-nehru-a26040257/' },
    { svg: x, name: 'X', href: 'https://x.com/pragdxshn' },
    { svg: github, name: 'GitHub', href: 'https://github.com/pragadeeshnehru' },
];
---
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script is:inline>
        try {
            const saved = localStorage.getItem('portfolio-theme');
            document.documentElement.dataset.theme = saved === 'light' || saved === 'dark' ? saved : (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        } catch { document.documentElement.dataset.theme = 'light'; }
    </script>
    <title>Pragadeesh Nehru</title>
    <meta name="description" content="Pragadeesh Nehru - developer, artist and writer. Portfolio." />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
</head>
<body>
    <a class="skip-link" href="#about">Skip to content</a>
    <div class="loader" id="loader" aria-hidden="true">
        <svg class="loader-atom" id="loaderEclipse" viewBox="0 0 200 200" aria-hidden="true"><Fragment set:html={ATOM} /></svg>
        <svg class="loader-brand" viewBox="0 0 100 100"><path d={BRAND} /></svg>
        <div class="loader-name">PRAGADEESH</div>
        <div class="loader-count" id="loaderCount">0</div>
        <div class="loader-bar"><span id="loaderBar"></span></div>
    </div>

    <canvas class="ember-trail" id="trail" aria-hidden="true"></canvas>
    <div class="grain" aria-hidden="true"></div>
    <div class="bg-anim" aria-hidden="true">
        <div class="pattern-base"></div>
        <div class="pattern-light" id="patternLight"></div>
        <div class="mobile-aura"></div>
        <div class="bg-glow one"></div>
        <div class="bg-glow two"></div>
        <span class="spark" style="left:7%;animation-delay:0s;animation-duration:17s"></span>
        <span class="spark" style="left:16%;animation-delay:4s;animation-duration:14s"></span>
        <span class="spark" style="left:27%;animation-delay:8s;animation-duration:19s"></span>
        <span class="spark" style="left:38%;animation-delay:2s;animation-duration:15s"></span>
        <span class="spark" style="left:47%;animation-delay:11s;animation-duration:18s"></span>
        <span class="spark" style="left:58%;animation-delay:6s;animation-duration:13s"></span>
        <span class="spark" style="left:67%;animation-delay:1s;animation-duration:16s"></span>
        <span class="spark" style="left:77%;animation-delay:9s;animation-duration:20s"></span>
        <span class="spark" style="left:86%;animation-delay:5s;animation-duration:14s"></span>
        <span class="spark" style="left:94%;animation-delay:12s;animation-duration:17s"></span>
    </div>
    <div class="progress" id="progress" aria-hidden="true"></div>

    <nav class="nav-pill" id="nav">
        <button class="nav-link" data-go="about">About</button>
        <button class="nav-link" data-go="works">Works</button>
        <button class="nav-link" data-go="contact">Contact</button>
        <button class="theme-toggle" id="themeToggle" aria-label="Switch colour mode" type="button">Mode</button>
    </nav>

    <section class="hero" id="hero">
        <svg class="atom" viewBox="0 0 200 200" aria-hidden="true"><Fragment set:html={ATOM} /></svg>
        <div class="spotlight" aria-hidden="true"></div>
        <svg class="brand-watermark" viewBox="0 0 100 100" aria-hidden="true"><path d={BRAND} /></svg>
        <span class="tw t1" aria-hidden="true"></span>
        <span class="tw t2" aria-hidden="true"></span>
        <span class="tw t3" aria-hidden="true"></span>
        <span class="tw t4" aria-hidden="true"></span>
        <span class="tw t5" aria-hidden="true"></span>
        <div class="role-icons rv" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="m8 4-8 8 8 8 3-3-5-5 5-5Zm8 0-3 3 5 5-5 5 3 3 8-8Z"/></svg>
            <svg viewBox="0 0 24 24"><path d="m12 1 7 10-7 12-7-12Zm0 6a2 2 0 1 0 0 4 2 2 0 0 0 0-4Z" fill-rule="evenodd"/></svg>
            <svg viewBox="0 0 24 24"><path d="M21 1c-7 1-13 5-13 10 0 3 2 5 5 5 5 0 7-8 8-15ZM7 14c-6 0-2 6-7 8 8 3 13-3 7-8Z"/></svg>
        </div>
        <p class="kicker rv">Hi, I am</p>
        <div class="name-frame rv">
            <h1 class="hero-name">PRAGADEESH</h1>
            <div class="hero-orn" aria-hidden="true"><span></span><svg viewBox="0 0 100 100"><path d={BRAND} /></svg><span></span></div>
        </div>
        <p class="hero-sub rv"><span>I am</span><span class="flip" id="flip">an artist</span></p>
        <p class="scroll-cue rv" aria-hidden="true">scroll &#9662;</p>
    </section>

    <section class="movement" id="about">
        <header class="m-head rv">
            <span class="section-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path fill-rule="evenodd" d="M12 2a5 5 0 1 0 0 10 5 5 0 0 0 0-10ZM3 23v-3a9 9 0 0 1 18 0v3Z" /></svg></span>
            <h2 class="m-title ink">ABOUT</h2>
            <p class="m-sub">developer, writer, artist - the struggler behind the work</p>
        </header>
        <div class="personas">
            {personas.map((p, i) => (
                <div class={`persona rv ${i % 2 ? 'from-right' : 'from-left'}`}>
                    <img src={p.img} alt={p.alt} loading="lazy" decoding="async" />
                    <div><strong>{p.title}</strong><p>{p.text}</p></div>
                </div>
            ))}
        </div>
    </section>

    <section class="movement" id="works">
        <header class="m-head rv">
            <span class="section-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path fill-rule="evenodd" d="M12 2C6.5 2 2 6.1 2 11.3 2 17.2 6.9 22 12.5 22c2.5 0 3.5-2.2 2-3.7-.9-.9-.4-2.3 1-2.3H18c3 0 4-2.4 4-5 0-5-4.5-9-10-9ZM7 8a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3Zm6-2a1.5 1.5 0 1 1 3 0 1.5 1.5 0 0 1-3 0Zm5 6a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3ZM5 13a1.5 1.5 0 1 1 3 0 1.5 1.5 0 0 1-3 0Z" /></svg></span>
            <h2 class="m-title ink">ART</h2>
            <p class="m-sub">the manga wall - panels from the gallery</p>
        </header>
        <div class="panels">
            {panels.map((p, i) => (
                <figure class={`panel rv ${i % 2 ? 'from-right' : 'from-left'}`}>
                    <img src={p.src} alt={p.title} loading="lazy" decoding="async" />
                    <figcaption><strong>{p.title}</strong><span>{p.quote}</span></figcaption>
                </figure>
            ))}
        </div>
    </section>

    <section class="movement" id="writing">
        <header class="m-head rv">
            <span class="section-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path fill-rule="evenodd" d="M3 17 16.5 3.5a2.8 2.8 0 0 1 4 4L7 21H3Zm1 6h17v-2H9Z" /></svg></span>
            <h2 class="m-title gold">WRITING</h2>
            <p class="m-sub">books, culture and criticism - latest from Medium</p>
        </header>
        <div class="articles rv" id="articles">
            <p class="articles-status">Loading articles...</p>
        </div>
    </section>

    <section class="movement" id="craft">
        <header class="m-head rv">
            <span class="section-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path fill-rule="evenodd" d="M8 2h8v3h3v3h3v8h-3v3h-3v3H8v-3H5v-3H2V8h3V5h3Zm0 6v8h8V8Z" /></svg></span>
            <h2 class="m-title ink">THE CRAFT</h2>
            <p class="m-sub">the stack behind the stage</p>
        </header>
        {tech.map((g) => (
            <div class="tech-group rv">
                <h3>{g.group}</h3>
                <div class="tech-row">
                    {g.items.map((t) => (
                        <div class="tech" style={`--stack-color: ${techColors[t.name] || "#b29aff"}`}><Fragment set:html={t.svg} /><span>{t.name}</span></div>
                    ))}
                </div>
            </div>
        ))}
    </section>

    <footer class="foot" id="contact">
        <header class="m-head rv">
            <span class="section-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path fill-rule="evenodd" d="M2 4h20v3L12 14 2 7Zm0 6 10 7 10-7v10H2Z" /></svg></span>
            <h2 class="m-title gold">CONTACT</h2>
            <p class="m-sub">find me around the web</p>
        </header>
        <blockquote class="quote rv">
            "Those who were seen dancing were thought to be insane by those who could not hear the music."
            <small>- Friedrich Nietzsche</small>
        </blockquote>
        <div class="dock rv">
            {socials.map((s) => (
                <a class="dock-item" href={s.href} target="_blank" rel="noreferrer" aria-label={s.name}>
                    <Fragment set:html={s.svg} />
                </a>
            ))}
        </div>
        <p class="foot-line rv">Built by Pragadeesh Nehru</p>
    </footer>

<script>
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const themeToggle = document.getElementById('themeToggle');
    const syncThemeButton = () => {
        const dark = document.documentElement.dataset.theme === 'dark';
        themeToggle.textContent = dark ? 'Light' : 'Dark';
        themeToggle.setAttribute('aria-label', dark ? 'Switch to light mode' : 'Switch to dark mode');
        themeToggle.setAttribute('aria-pressed', String(dark));
    };
    syncThemeButton();
    themeToggle.addEventListener('click', () => {
        const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = next;
        try { localStorage.setItem('portfolio-theme', next); } catch {}
        syncThemeButton();
    });

    document.documentElement.classList.add('js');

    // bidirectional reveals (set up first so content can never be stranded invisible)
    const revealAll = () => document.querySelectorAll('.rv').forEach((el) => el.classList.add('rv-in'));
    if ('IntersectionObserver' in window) {
        let ioWorking = false;
        const io = new IntersectionObserver((entries) => {
            ioWorking = true;
            for (const e of entries) e.target.classList.toggle('rv-in', e.isIntersecting);
        }, { threshold: 0.15, rootMargin: '0px 0px -6% 0px' });
        document.querySelectorAll('.rv').forEach((el) => io.observe(el));
        // fail-open: if the observer never reports back, show everything
        setTimeout(() => { if (!ioWorking) revealAll(); }, 3000);
    } else {
        revealAll();
    }

    // loader
    const loader = document.getElementById('loader');
    const hero = document.getElementById('hero');
    const finish = () => {
        loader.classList.add('lift');
        hero.classList.add('hero-in');
        setTimeout(() => loader.remove(), 900);
    };
    if (reduce) { finish(); }
    else {
        document.body.style.overflow = 'hidden';
        const count = document.getElementById('loaderCount');
        const bar = document.getElementById('loaderBar');
        const ec = document.getElementById('loaderEclipse');
        const start = performance.now();
        const total = 1900;
        const tick = (t) => {
            const p = Math.min(1, (t - start) / total);
            const e = 1 - Math.pow(1 - p, 3);
            count.textContent = String(Math.round(e * 100));
            bar.style.width = (e * 100) + '%';
            ec.style.transform = 'scale(' + (0.6 + e * 0.4) + ')';
            if (p < 1) requestAnimationFrame(tick);
            else { document.body.style.overflow = ''; setTimeout(finish, 300); }
        };
        requestAnimationFrame(tick);
    }

    // flip words
    const words = ['an artist', 'a developer', 'a writer'];
    const flip = document.getElementById('flip');
    let wi = 0;
    if (!reduce) setInterval(() => {
        wi = (wi + 1) % words.length;
        flip.textContent = words[wi];
        flip.classList.remove('swap');
        void flip.offsetWidth;
        flip.classList.add('swap');
    }, 2200);

    // nav + progress
    const nav = document.getElementById('nav');
    const progress = document.getElementById('progress');
    let ticking = false;
    const onScroll = () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
            const y = window.scrollY;
            nav.classList.toggle('solid', y > 40);
            const h = document.documentElement.scrollHeight - window.innerHeight;
            progress.style.transform = 'scaleX(' + (h > 0 ? y / h : 0) + ')';
            ticking = false;
        });
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
    document.querySelectorAll('.nav-link').forEach((b) =>
        b.addEventListener('click', () => document.getElementById(b.dataset.go)?.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth' })));

    // Gentle card tilt only where a precise pointer is available.
    if (window.matchMedia('(hover: hover) and (pointer: fine)').matches && !reduce) {
        document.querySelectorAll('.persona, .panel').forEach((card) => {
            let frame = 0;
            card.addEventListener('pointermove', (e) => {
                if (frame) return;
                frame = requestAnimationFrame(() => {
                    const r = card.getBoundingClientRect();
                    const x = (e.clientX - r.left) / r.width - .5;
                    const y = (e.clientY - r.top) / r.height - .5;
                    card.style.setProperty('--tilt-x', (-y * 8) + 'deg');
                    card.style.setProperty('--tilt-y', (x * 8) + 'deg');
                    frame = 0;
                });
            }, { passive: true });
            card.addEventListener('pointerleave', () => {
                if (frame) cancelAnimationFrame(frame);
                frame = 0;
                card.style.setProperty('--tilt-x', '0deg');
                card.style.setProperty('--tilt-y', '0deg');
            });
        });
    }

    // ember trail
    const fine = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
    // A single paint per pointer frame, with no idle animation loop.
    const pattern = document.getElementById('patternLight');
    if (fine && !reduce && pattern) {
        let patternFrame = 0;
        let px = window.innerWidth * .65, py = window.innerHeight * .4;
        window.addEventListener('pointermove', (e) => {
            px = e.clientX; py = e.clientY;
            if (patternFrame) return;
            patternFrame = requestAnimationFrame(() => {
                pattern.style.setProperty('--px', px + 'px');
                pattern.style.setProperty('--py', py + 'px');
                patternFrame = 0;
            });
        }, { passive: true });
    }

    const canvas = document.getElementById('trail');
    if (fine && !reduce && canvas) {
        const ctx = canvas.getContext('2d');
        let w, h;
        const dpr = Math.min(window.devicePixelRatio || 1, 2);
        const resize = () => {
            w = window.innerWidth; h = window.innerHeight;
            canvas.width = w * dpr; canvas.height = h * dpr;
            canvas.style.width = w + 'px'; canvas.style.height = h + 'px';
            ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        };
        resize();
        window.addEventListener('resize', resize);
        const pts = [];
        let trailFrame = 0;
        const trailAccent = ['#f8e55b', '#9b7bff', '#83e3b0', '#ff91b5'];
        window.addEventListener('pointermove', (e) => {
            pts.push({ x: e.clientX, y: e.clientY, life: 1, gold: Math.random() > 0.5 });
            if (pts.length > 50) pts.shift();
            if (!trailFrame) trailFrame = requestAnimationFrame(draw);
        });
        const draw = () => {
            ctx.clearRect(0, 0, w, h);
            for (const p of pts) {
                p.life *= 0.94;
                ctx.beginPath();
                ctx.globalAlpha = p.life * .8;
                ctx.fillStyle = p.gold ? trailAccent[0] : trailAccent[1];
                ctx.shadowColor = p.gold ? trailAccent[0] : trailAccent[1];
                ctx.shadowBlur = 12;
                ctx.arc(p.x, p.y, 1 + p.life * 3.2, 0, Math.PI * 2);
                ctx.fill();
            }
            while (pts.length && pts[0].life < 0.04) pts.shift();
            trailFrame = pts.length ? requestAnimationFrame(draw) : 0;
        };
    } else if (canvas) canvas.remove();

    // medium feed
    const box = document.getElementById('articles');
    fetch('/api/medium')
        .then((r) => r.json())
        .then((list) => {
            if (!Array.isArray(list) || !list.length) throw new Error('empty');
            box.innerHTML = '';
            for (const a of list.slice(0, 6)) {
                const el = document.createElement('a');
                el.className = 'article';
                el.href = a.link;
                el.target = '_blank';
                el.rel = 'noreferrer';
                const date = a.pubDate ? new Date(a.pubDate).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) : '';
                el.innerHTML = '<strong></strong><span></span>';
                el.querySelector('strong').textContent = a.title;
                el.querySelector('span').textContent = date;
                box.appendChild(el);
            }
        })
        .catch(() => {
            box.innerHTML = '<p class="articles-status">Articles live at <a class="medium-link" href="https://medium.com/@pragadeeshnehru" target="_blank" rel="noreferrer">medium.com/@pragadeeshnehru</a></p>';
        });
</script>
</body>
</html>
